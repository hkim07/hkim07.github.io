---
import Page from '../layouts/Page.astro';
import fs from 'fs';
import path from 'path';
import matter from 'gray-matter';

interface Publication {
  title: string;
  venue: string;
  date: string;
  paperurl: string;
  excerpt: string;
}

const publicationsDir = path.join(process.cwd(), 'src/content/publications');
const files = fs.readdirSync(publicationsDir).filter(f => f.endsWith('.md'));

const publications: Publication[] = [];
files.forEach(file => {
  const content = fs.readFileSync(path.join(publicationsDir, file), 'utf-8');
  const { data } = matter(content);
  publications.push({
    title: data.title,
    venue: data.venue,
    date: data.date,
    paperurl: data.paperurl,
    excerpt: data.excerpt
  });
});

// Sort by date descending
publications.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Page title="Publications" description="Research publications by Hyunuk Kim">
  <div class="publications-container">
    <h1>Publications</h1>
    <p class="intro-text">A curated list of my research publications across network science, NLP, machine learning, and computational social science.</p>

    <div class="publications-list">
      {publications.map((pub, index) => (
        <article class="publication-item" key={index}>
          <div class="pub-header">
            <h3 class="pub-title">
              <a href={pub.paperurl} target="_blank" rel="noopener">
                {pub.title}
              </a>
            </h3>
            <p class="pub-venue">{pub.venue}</p>
            <p class="pub-date">{new Date(pub.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
          </div>
          {pub.excerpt && (
            <p class="pub-excerpt">{pub.excerpt}</p>
          )}
          <a href={pub.paperurl} target="_blank" rel="noopener" class="read-link">Read Paper →</a>
        </article>
      ))}
    </div>
  </div>

  <style>
    .publications-container {
      max-width: 900px;
    }

    .publications-container h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
      font-weight: 700;
    }

    .intro-text {
      font-size: 1.1rem;
      color: var(--color-text-secondary);
      margin-bottom: 2rem;
      line-height: 1.6;
    }

    .publications-list {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .publication-item {
      padding: 1.5rem;
      border: 1px solid var(--color-border);
      border-radius: 8px;
      transition: all 0.3s;
    }

    .publication-item:hover {
      border-color: var(--color-accent);
      box-shadow: 0 4px 12px rgba(37, 99, 235, 0.1);
    }

    .pub-header {
      margin-bottom: 1rem;
    }

    .pub-title {
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      line-height: 1.4;
    }

    .pub-title a {
      color: var(--color-text);
      text-decoration: none;
    }

    .pub-title a:hover {
      color: var(--color-accent);
    }

    .pub-venue {
      color: var(--color-accent);
      font-weight: 600;
      margin-bottom: 0.25rem;
      font-size: 0.95rem;
    }

    .pub-date {
      color: var(--color-text-secondary);
      font-size: 0.9rem;
    }

    .pub-excerpt {
      color: var(--color-text-secondary);
      font-size: 0.95rem;
      line-height: 1.6;
      margin-bottom: 1rem;
    }

    .read-link {
      display: inline-block;
      color: var(--color-accent);
      font-size: 0.95rem;
      font-weight: 500;
      transition: all 0.2s;
    }

    .read-link:hover {
      transform: translateX(4px);
      text-decoration: none;
    }

    @media (max-width: 768px) {
      .publications-container h1 {
        font-size: 1.8rem;
      }

      .pub-title {
        font-size: 1.1rem;
      }

      .publication-item {
        padding: 1rem;
      }
    }
  </style>
</Page>
